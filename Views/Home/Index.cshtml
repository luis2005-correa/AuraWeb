@model IEnumerable<Aura.Models.CatalogImage>
@{
    ViewData["Title"] = "Inicio - Aura";
}

<div class="relative bg-neutral-900 text-white overflow-hidden mb-16 rounded-3xl shadow-2xl mx-4 mt-4">
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-cover bg-center opacity-70 scale-105" style="background-image: url('https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1440&auto=format&fit=crop');"></div>
    <div class="relative z-20 max-w-4xl mx-auto px-6 py-24 sm:py-32 text-center sm:text-left">
        <span class="inline-block bg-amber-400/20 text-amber-300 text-[10px] tracking-widest uppercase font-bold px-4 py-1.5 rounded-full border border-amber-400/30 mb-6">Nueva Coleccion 2026</span>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight mb-5 leading-tight">Define tu propio<br>estilo con <span class="text-amber-400">Aura</span></h1>
        <p class="text-base text-neutral-300 max-w-xl mb-10 leading-relaxed">Explora nuestra seleccion exclusiva de prendas de alta calidad y accesorios minimalistas.</p>
        <div class="flex flex-col sm:flex-row gap-3">
            <a href="/Catalog" class="bg-amber-400 hover:bg-amber-500 text-neutral-900 font-bold px-8 py-3.5 rounded-xl transition-all duration-300 shadow-lg inline-flex items-center justify-center gap-2 transform hover:-translate-y-0.5 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                Explorar Catalogo
            </a>
            <a href="#novedades" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3.5 rounded-xl transition-all duration-300 border border-white/20 inline-flex items-center justify-center text-sm backdrop-blur-sm">Ver Novedades</a>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/Catalog" class="group relative overflow-hidden rounded-2xl bg-neutral-900 text-white p-6 h-36 flex flex-col justify-end hover:scale-[1.02] transition-all duration-300 shadow-md">
            <div class="absolute inset-0 bg-cover bg-center opacity-50 group-hover:opacity-70 transition-opacity duration-300" style="background-image: url('https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=400&auto=format&fit=crop');"></div>
            <div class="relative z-10"><p class="text-xs text-amber-400 font-bold uppercase tracking-wider mb-1">Shop</p><h3 class="text-base font-bold">Camisetas</h3></div>
        </a>
        <a href="/Catalog" class="group relative overflow-hidden rounded-2xl bg-neutral-900 text-white p-6 h-36 flex flex-col justify-end hover:scale-[1.02] transition-all duration-300 shadow-md">
            <div class="absolute inset-0 bg-cover bg-center opacity-50 group-hover:opacity-70 transition-opacity duration-300" style="background-image: url('https://images.unsplash.com/photo-1594938298603-c8148c4b4057?q=80&w=400&auto=format&fit=crop');"></div>
            <div class="relative z-10"><p class="text-xs text-amber-400 font-bold uppercase tracking-wider mb-1">Shop</p><h3 class="text-base font-bold">Pantalones</h3></div>
        </a>
    </div>
</div>

<div id="novedades" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div>
            <p class="text-xs text-amber-500 font-bold uppercase tracking-widest mb-2">Novedades</p>
            <h2 class="text-3xl font-black text-neutral-900 tracking-tight">Productos Destacados</h2>
        </div>
        <a href="/Catalog" class="text-sm font-semibold text-neutral-600 hover:text-amber-500 flex items-center gap-1.5 transition-colors group">
            Ver todo el catalogo
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        @if (Model != null && Model.Any())
        {
            @foreach (var producto in Model)
            {
                <div class="group relative flex flex-col bg-white border border-neutral-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="relative aspect-square overflow-hidden bg-neutral-100">
                        <img src="@producto.ImageUrl" alt="@producto.ImageName"
                             class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                             onerror="this.src='https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=500&auto=format&fit=crop'" />
                        <div class="absolute top-3 right-3"><span class="bg-white/90 backdrop-blur-sm text-neutral-700 text-[10px] font-bold px-2 py-1 rounded-full border border-neutral-200">Nuevo</span></div>
                    </div>
                    <div class="p-4 flex flex-col gap-3">
                        <div>
                            <p class="text-[10px] text-amber-500 font-bold uppercase tracking-widest mb-1">Esencial</p>
                            <h3 class="text-sm font-bold text-neutral-800 line-clamp-1">@producto.ImageName</h3>
                            <p class="text-lg font-black text-neutral-900 mt-1">$@producto.Precio.ToString("F2")</p>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="addToCart(@producto.Id, '@Html.Raw(producto.ImageName.Replace("'", @"\'"))', @producto.Precio, '@producto.ImageUrl')"
                                    class="flex-1 bg-neutral-900 hover:bg-amber-500 text-white hover:text-neutral-900 text-xs font-bold py-2.5 px-3 rounded-xl transition-all duration-200 flex items-center justify-center gap-1.5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z" /></svg>
                                Al carrito
                            </button>
                            <a href="/Catalog" class="p-2.5 border border-neutral-200 hover:border-amber-400 hover:text-amber-500 text-neutral-600 rounded-xl transition-all duration-200 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-16 bg-white border border-dashed border-neutral-200 rounded-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-neutral-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z" /></svg>
                <p class="text-neutral-400 text-sm font-medium">No hay productos disponibles.</p>
                <a href="/Catalog" class="mt-3 inline-block text-xs text-amber-500 font-semibold hover:underline">Ir al catalogo</a>
            </div>
        }
    </div>
</div>